<!DOCTYPE html>
<html>
<head>
  <title>archive - songlists.lol</title>
  <link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div id="star-rain"></div>

<script>
for (let i = 0; i < 40; i++) {
  const star = document.createElement("div");
  star.className = "falling-star";

  star.innerHTML = "★";

  star.style.left = Math.random() * 100 + "vw";
  star.style.animationDuration = (6 + Math.random() * 10) + "s";
  star.style.animationDelay = (-Math.random() * 15) + "s";
  star.style.fontSize = (10 + Math.random() * 18) + "px";

  document.getElementById("star-rain").appendChild(star);
}
</script>
<div class="star-rain"></div>
<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>
    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]
    [ <a href="/logout">logout</a> ]
  <% } else { %>
    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]
  <% } %>
</div>

<div class="board-nav">
  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(board => { %>
      <a href="/<%= board.slug %>">/<%= board.slug %>/</a>
    <% }) %>
  <% } %>
</div>

<div class="header">
  <img src="https://files.catbox.moe/kxbylk.png" class="mascot">
  <h1>archive</h1>
  <p>older threads</p>
</div>

<% threads.forEach(thread => { %>
  <div class="post">
    <div class="post-title">
      <a href="/<%= thread.board_slug %>/thread/<%= thread.id %>"><%= thread.title %></a>
    </div>

    <div class="post-meta">
      /<%= thread.board_slug %>/ |
      by <%= thread.author %> |
      <%= new Date(thread.created_at).toLocaleString() %>
    </div>
  </div>
<% }) %>

</body>
</html>
