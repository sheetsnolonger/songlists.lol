<!DOCTYPE html>
<html>
<head>
  <title>archive - songlists.lol</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="top-nav">

  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>

    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]

    <form method="POST" action="/logout" style="display:inline;">
      <button class="inline-btn">logout</button>
    </form>

  <% } else { %>

    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]

  <% } %>

  [ <button id="mobile-toggle">mobile mode</button> ]

  <br>

  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(board => { %>
      <a class="genre-<%= board.slug %>" href="/<%= board.slug %>">
        /<%= board.slug %>/
      </a>
    <% }) %>
  <% } %>

</div>

<div class="header">
  <img src="https://files.catbox.moe/n4puao.jpg" class="mascot">
  <h1>archive</h1>
  <p>older threads</p>
</div>

<% threads.forEach(thread => { %>
  <div class="post">
    <div class="post-title">
      <a href="/<%= thread.board_slug %>/thread/<%= thread.id %>"><%= thread.title %></a>
    </div>

    <div class="post-meta">
      /<%= thread.board_slug %>/ |
      by <%= thread.author %> |
      <%= new Date(thread.created_at).toLocaleString() %>
    </div>
  </div>
<% }) %>

</body>
</html>
