<!DOCTYPE html>
<html>
<head>
  <title><%= profile.username %> - songlists.lol</title>
<link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
<link rel="stylesheet" href="/style.css">

<% if (profile.custom_css) { %>
<style>
<%- profile.custom_css %>
</style>
<% } %>
</head>
<body>

<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>
    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]
    [ <a href="/logout">logout</a> ]
  <% } else { %>
    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]
  <% } %>
</div>

<div class="board-nav">
  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(board => { %>
      <a href="/<%= board.slug %>">/<%= board.slug %>/</a>
    <% }) %>
  <% } %>
</div>
<div class="profile-box">
  <% if (profile.avatar_url) { %>
    <img class="profile-avatar" src="<%= profile.avatar_url %>">
  <% } %>

  <h1>
  <%= profile.username %>
  <%- userBadge(profile.role) %>
</h1>
  <p>joined <%= new Date(profile.created_at).toLocaleString() %></p>

  <div class="profile-bio">
    <%= profile.bio || "no bio yet." %>
  </div>
</div>

<h2 class="section-title">threads</h2>

<% threads.forEach(thread => { %>
  <div class="post">
    <a href="/<%= thread.board_slug %>/thread/<%= thread.id %>">
      <%= thread.title %>
    </a>
    <div class="post-meta">/<%= thread.board_slug %>/</div>
  </div>
<% }) %>

<h2 class="section-title">replies</h2>

<% replies.forEach(reply => { %>
  <div class="post">
    <div class="post-body"><%- formatBody(reply.body) %></div>
    <div class="post-meta">reply no.<%= reply.id %></div>
  </div>
<% }) %>

</body>
</html>
