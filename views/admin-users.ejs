<!DOCTYPE html>
<html>
<head>
  <title>admin users</title>
<link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div id="star-rain"></div>
<script src="/stars.js"></script>
<div class="top-nav">
  [ <a href="/secret-admin">admin home</a> ]
  [ <a href="/">site home</a> ]
</div>

<h1 class="section-title">users</h1>

<% users.forEach(user => { %>
  <div class="post">
    <div class="post-title">
      <a href="/u/<%= user.username %>"><%= user.username %></a>
    </div>

    <div class="post-meta">
      joined <%= new Date(user.created_at).toLocaleString() %>
    </div>

<form method="POST" action="/admin/user/<%= user.id %>/delete" onsubmit="return confirm('delete this user? their posts may remain.');">
  <button>delete user</button>
</form>
  </div>
<% }) %>

</body>
</html>
