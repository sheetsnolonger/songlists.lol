<!DOCTYPE html>
<html>
<head>
  <title>profile settings - songlists.lol</title>
<link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/u/<%= user.username %>">my profile</a> ]
</div>

<div class="header">
  <h1>profile settings</h1>
</div>

<div class="post-form">
  <form method="POST" action="/settings/profile">
    <label>avatar image url</label>
    <input name="avatar_url" placeholder="https://files.catbox.moe/image.jpg" value="<%= user.avatar_url || '' %>">

    <label>bio</label>
    <textarea name="bio"><%= user.bio || "" %></textarea>

    <button>save profile</button>
  </form>
</div>

</body>
</html>
