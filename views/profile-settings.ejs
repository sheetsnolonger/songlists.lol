<!DOCTYPE html>
<html>
<head>
  <title>profile settings - songlists.lol</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/u/<%= user.username %>">my profile</a> ]
</div>

<div class="header">
  <h1>profile settings</h1>
</div>

<% if (error) { %>
  <div class="notice"><%= error %></div>
<% } %>

<div class="post-form">
  <form method="POST" action="/settings/profile" enctype="multipart/form-data">
    <label>avatar image</label>
    <input type="file" name="avatar" accept="image/*">

    <label>bio</label>
    <textarea name="bio" placeholder="bio"><%= user.bio || "" %></textarea>

    <button>save profile</button>
  </form>
</div>

</body>
</html>
