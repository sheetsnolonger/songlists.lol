<!DOCTYPE html>
<html>
<head>
  <title>songlists.lol</title>
  <link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div id="star-rain"></div>
<script src="/stars.js"></script>
<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>
    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]
    [ <a href="/logout">logout</a> ]
  <% } else { %>
    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]
  <% } %>
</div>

<div class="board-nav">
  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(board => { %>
      <a href="/<%= board.slug %>">/<%= board.slug %>/</a>
    <% }) %>
  <% } %>
</div>

<div class="header">
  <img src="https://files.catbox.moe/kxbylk.png" class="mascot">
  <h1>songlists</h1>
  <p>/mu/ 4 music</p>
</div>

<% if (artists && artists.length) { %>

<div class="artist-showcase">

  <div class="section-title">
    artists
  </div>

  <div class="artist-grid">
    <% artists.forEach(artist => { %>

      <a href="/artist/<%= artist.slug %>" class="artist-card">

        <% if (artist.avatar_url) { %>
          <img
            src="<%= artist.avatar_url %>"
            alt="<%= artist.name %>"
          >
        <% } else { %>
          <div class="artist-placeholder">♪</div>
        <% } %>

        <div class="artist-name">
          <%= artist.name %>
        </div>

      </a>

    <% }) %>
  </div>

</div>

<% } %>

<div class="board-wrap">

  <div class="board-category">
    <h2>general</h2>
    <% boards.filter(b => ["mu", "shr", "rec", "cht"].includes(b.slug)).forEach(board => { %>
      <div class="board-entry">
        <a class="genre-<%= board.slug %>" href="/<%= board.slug %>">/<%= board.slug %>/</a>
        <span><%= board.name %></span>
        <small>- <%= board.description %></small>
        <em><%= board.thread_count %> threads</em>
      </div>
    <% }) %>
  </div>

  <div class="board-category">
    <h2>rock / guitar</h2>
    <% boards.filter(b => ["rok", "met", "pnk", "emo", "shg", "grg", "gth"].includes(b.slug)).forEach(board => { %>
      <div class="board-entry">
        <a class="genre-<%= board.slug %>" href="/<%= board.slug %>">/<%= board.slug %>/</a>
        <span><%= board.name %></span>
        <small>- <%= board.description %></small>
        <em><%= board.thread_count %> threads</em>
      </div>
    <% }) %>
  </div>

  <div class="board-category">
    <h2>pop / rap</h2>
    <% boards.filter(b => ["hip", "rnb", "pop", "kpop", "jpop"].includes(b.slug)).forEach(board => { %>
      <div class="board-entry">
        <a class="genre-<%= board.slug %>" href="/<%= board.slug %>">/<%= board.slug %>/</a>
        <span><%= board.name %></span>
        <small>- <%= board.description %></small>
        <em><%= board.thread_count %> threads</em>
      </div>
    <% }) %>
  </div>

  <div class="board-category">
    <h2>electronic</h2>
    <% boards.filter(b => ["elec", "idm", "dnb", "dub", "tec", "hou", "tra", "hxc", "brc", "amb", "vap"].includes(b.slug)).forEach(board => { %>
      <div class="board-entry">
        <a class="genre-<%= board.slug %>" href="/<%= board.slug %>">/<%= board.slug %>/</a>
        <span><%= board.name %></span>
        <small>- <%= board.description %></small>
        <em><%= board.thread_count %> threads</em>
      </div>
    <% }) %>
  </div>

  <div class="board-category">
    <h2>other</h2>
    <% boards.filter(b => ["jaz", "blu", "fol", "cty", "cls", "ind", "noi", "exp", "ost", "wld", "lat", "reg", "vin", "gear", "prod"].includes(b.slug)).forEach(board => { %>
      <div class="board-entry">
        <a class="genre-<%= board.slug %>" href="/<%= board.slug %>">/<%= board.slug %>/</a>
        <span><%= board.name %></span>
        <small>- <%= board.description %></small>
        <em><%= board.thread_count %> threads</em>
      </div>
    <% }) %>
  </div>

</div>

<h2 class="section-title">recent threads</h2>

<% recent.forEach(thread => { %>
  <div class="recent-thread">
    <a href="/<%= thread.board_slug %>/thread/<%= thread.id %>">
      <% if (thread.pinned) { %>[pinned] <% } %><%= thread.title %>
    </a>
    <span>/<%= thread.board_slug %>/</span>
    <small>by <%= thread.author %></small>
  </div>
<% }) %>

<div class="footer">© 2026 songlists.lol</div>

</body>
</html>
