<!DOCTYPE html>
<html>
<head>
  <title>catalog - songlists.lol</title>
  <link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div id="star-rain"></div>
<script src="/stars.js"></script>
<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>
    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]
    [ <a href="/logout">logout</a> ]
  <% } else { %>
    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]
  <% } %>
</div>

<div class="board-nav">
  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(board => { %>
      <a href="/<%= board.slug %>">/<%= board.slug %>/</a>
    <% }) %>
  <% } %>
</div>

<div class="header">
  <img src="https://files.catbox.moe/kxbylk.png" class="mascot">
  <h1>catalog</h1>
  <p>all recent threads</p>
</div>

<% threads.forEach(thread => { %>
  <div class="post">
    <div class="post-title">
      <% if (thread.pinned) { %><span class="pinned">[pinned]</span><% } %>
      <a href="/<%= thread.board_slug %>/thread/<%= thread.id %>"><%= thread.title %></a>
    </div>

    <div class="post-meta">
      /<%= thread.board_slug %>/ |
      replies: <%= thread.reply_count %> |
      by <%= thread.author %>
    </div>

    <div class="post-body"><%= thread.body %></div>
  </div>
<% }) %>

</body>
</html>
