<!DOCTYPE html>
<html>
<head>
  <title>login - songlists.lol</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/signup">signup</a> ]
</div>

<div class="header">
  <img src="https://files.catbox.moe/n4puao.jpg" class="mascot">
  <h1>login</h1>
</div>

<% if (error) { %>
  <div class="notice"><%= error %></div>
<% } %>

<div class="post-form">
  <form method="POST" action="/login">
    <input name="username" placeholder="username" required>
    <input type="password" name="password" placeholder="password" required>
    <button>login</button>
  </form>
</div>

</body>
</html>
