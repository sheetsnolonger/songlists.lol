<!DOCTYPE html>
<html>
<head>
  <title>/<%= board.slug %>/ - songlists.lol</title>
  <link rel="icon" type="image/png" href="https://files.catbox.moe/kxbylk.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>
    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]
    [ <a href="/logout">logout</a> ]
  <% } else { %>
    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]
  <% } %>
</div>

<div class="board-nav">
  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(board => { %>
      <a href="/<%= board.slug %>">/<%= board.slug %>/</a>
    <% }) %>
  <% } %>
</div>

<div class="header">
  <img src="https://files.catbox.moe/kxbylk.png" class="mascot">
  <h1>/<%= board.slug %>/</h1>
  <p><%= board.name %></p>
  <p><%= board.description %></p>
</div>

<div class="post-form">
  <h2>new thread</h2>

  <form method="POST" action="/<%= board.slug %>/thread" enctype="multipart/form-data">
    <input name="author" placeholder="name (optional)">
    <input name="title" placeholder="thread title" required>

    <textarea name="body" placeholder="post body"></textarea>

    <input type="file" name="media" accept="image/*,audio/*">

    <button>post</button>
  </form>
</div>

<h2 class="section-title">threads</h2>

<% if (threads.length === 0) { %>
  <div class="post">no threads yet.</div>
<% } %>

<% threads.forEach(thread => { %>
  <div class="post" id="t<%= thread.id %>">

    <div class="post-title">
      <% if (thread.pinned) { %>
        <span class="pinned">[pinned]</span>
      <% } %>

      <a href="/<%= board.slug %>/thread/<%= thread.id %>">
        <%= thread.title %>
      </a>
    </div>

    <div class="post-meta">
      <b>
<% if (thread.author !== "anon") { %>
  <b>
    <a href="/u/<%= thread.author %>"><%= thread.author %></a>
  </b>
  <%- userBadge(thread.author_role) %>
<% } else { %>
  <b>anon</b>
<% } %>
      |
      no.<%= thread.id %>
      |
      replies: <%= thread.reply_count %>
      |
      <%= new Date(thread.created_at).toLocaleString() %>
    </div>

    <div class="post-body">
      <%- formatBody(thread.body) %>
    </div>

    <% if (thread.media_url) { %>
      <div class="media">
        <% if (thread.media_type && thread.media_type.startsWith("image/")) { %>
          <a href="<%= thread.media_url %>" target="_blank">
            <img src="<%= thread.media_url %>">
          </a>
        <% } else if (thread.media_type && thread.media_type.startsWith("audio/")) { %>
          <audio controls src="<%= thread.media_url %>"></audio>
        <% } %>
      </div>
    <% } %>

  </div>
<% }) %>

</body>
</html>
