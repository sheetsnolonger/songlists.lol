<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title><%= thread.title %> - songlists.lol</title>

  <link rel="icon" href="https://files.catbox.moe/kxbylk.png">
  <link rel="shortcut icon" href="https://files.catbox.moe/kxbylk.png">
  <link rel="apple-touch-icon" href="https://files.catbox.moe/kxbylk.png">

  <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="top-nav">
  [ <a href="/">home</a> ]
  [ <a href="/catalog">catalog</a> ]
  [ <a href="/archive">archive</a> ]

  <% if (user) { %>
    [ <a href="/u/<%= user.username %>">profile</a> ]
    [ <a href="/settings/profile">profile settings</a> ]

    <form method="POST" action="/logout" style="display:inline;">
      [ <button class="inline-btn" type="submit">logout</button> ]
    </form>
  <% } else { %>
    [ <a href="/login">login</a> ]
    [ <a href="/signup">signup</a> ]
  <% } %>
</div>

<div class="board-nav">
  <% if (typeof boards !== "undefined") { %>
    <% boards.forEach(b => { %>
      <a class="genre-<%= b.slug %>" href="/<%= b.slug %>">/<%= b.slug %>/</a>
    <% }) %>
  <% } %>
</div>

<div class="header">
  <img src="https://files.catbox.moe/kxbylk.png" class="mascot">
  <h1>/<a href="/<%= board %>"><%= board %></a>/</h1>
</div>

<div class="post op" id="t<%= thread.id %>">

  <div class="post-title">
    <% if (thread.pinned) { %>
      <span class="pinned">[pinned]</span>
    <% } %>

    <%= thread.title %>
  </div>

  <div class="post-meta">
    <% if (thread.author !== "anon") { %>
      <b>
        <a href="/u/<%= thread.author %>"><%= thread.author %></a>
      </b>
      <%- userBadge(thread.author_role) %>
    <% } else { %>
      <b>anon</b>
    <% } %>

    |
    no.<%= thread.id %>
    |
    <%= new Date(thread.created_at).toLocaleString() %>
  </div>

  <div class="post-body">
    <%- formatBody(thread.body) %>
  </div>

  <% if (thread.media_url) { %>
    <div class="media">
      <% if (thread.media_type && thread.media_type.startsWith("image/")) { %>
        <a href="<%= thread.media_url %>" target="_blank">
          <img src="<%= thread.media_url %>">
        </a>
      <% } else if (thread.media_type && thread.media_type.startsWith("audio/")) { %>
        <audio controls src="<%= thread.media_url %>"></audio>
      <% } %>
    </div>
  <% } %>

  <form method="POST" action="/report/thread/<%= thread.id %>" class="report-form">
    <input name="reason" maxlength="300" placeholder="report reason">
    <button type="submit">report thread</button>
  </form>

</div>

<h2 class="section-title">replies</h2>

<% if (replies.length === 0) { %>
  <div class="post">no replies yet.</div>
<% } %>

<% replies.forEach(reply => { %>
  <div class="post" id="p<%= reply.id %>">

    <div class="post-meta">
      <% if (reply.author !== "anon") { %>
        <b>
          <a href="/u/<%= reply.author %>"><%= reply.author %></a>
        </b>
        <%- userBadge(reply.author_role) %>
      <% } else { %>
        <b>anon</b>
      <% } %>

      |
      no.<%= reply.id %>
      |
      <%= new Date(reply.created_at).toLocaleString() %>
    </div>

    <div class="post-body">
      <%- formatBody(reply.body) %>
    </div>

    <% if (reply.media_url) { %>
      <div class="media">
        <% if (reply.media_type && reply.media_type.startsWith("image/")) { %>
          <a href="<%= reply.media_url %>" target="_blank">
            <img src="<%= reply.media_url %>">
          </a>
        <% } else if (reply.media_type && reply.media_type.startsWith("audio/")) { %>
          <audio controls src="<%= reply.media_url %>"></audio>
        <% } %>
      </div>
    <% } %>

    <form method="POST" action="/report/reply/<%= reply.id %>" class="report-form">
      <input name="reason" maxlength="300" placeholder="report reason">
      <button type="submit">report reply</button>
    </form>

  </div>
<% }) %>

<div class="post-form">
  <h2>reply</h2>

  <form method="POST" action="/<%= board %>/thread/<%= thread.id %>/reply" enctype="multipart/form-data">

    <% if (!user) { %>
      <input name="author" placeholder="name (optional)">
    <% } %>

    <textarea name="body" placeholder="reply"></textarea>

    <input type="file" name="media" accept="image/*,audio/*">

    <button type="submit">post reply</button>
  </form>
</div>

<script src="/mobile.js"></script>

</body>
</html>
